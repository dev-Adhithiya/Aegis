# ==============================================================================
# AEGIS LEGAL INTELLIGENCE — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. GEMINI AI API KEY (Required for AI analysis, Q&A, and oral practice feedback)
# Obtain from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# 2. SESSION COOKIE SECRET (Required for signing cryptographic session tokens)
# Generate a 32+ character random string (e.g. openssl rand -hex 32)
SESSION_SECRET=

# 3. DATA ENCRYPTION KEY (Required for AES-256-GCM encryption at rest of sensitive legal text)
# Generate a 32+ character random string (e.g. openssl rand -hex 32)
DATA_ENCRYPTION_KEY=

# 4. ENVIRONMENT MODE
# Set to 'production' on Vercel deployment
NODE_ENV=production

# 5. INITIAL COUNSEL ACCOUNT (Optional: automatically registers initial admin on first boot)
# If left blank, users can register new accounts via the sign-up tab on the login screen.
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
INITIAL_USER_NAME=
